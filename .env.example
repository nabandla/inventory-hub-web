# Copy to .env for local development. Everything here ends up INSIDE the web page that
# visitors download, so it must never contain a secret. Client IDs and URLs are public.
VITE_API_BASE_URL=https://your-api-app.azurewebsites.net
VITE_TENANT_ID=your-entra-tenant-id
VITE_CLIENT_ID=this-website-app-registration-client-id
VITE_API_SCOPE=api://your-api-application-client-id/access_as_user
